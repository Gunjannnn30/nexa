# ---------------------------------------------------------------------------
# NEXA environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL (local embedded dev DB defaults shown)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexa?schema=public"

# Optional: test database used by integration tests
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexa_test?schema=public"

# Session
SESSION_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# AI (optional). NEXA works without AI; AI features explain what is missing.
# AI_PROVIDER: ollama | gemini | openai | none
# ---------------------------------------------------------------------------
AI_PROVIDER="none"
AI_TIMEOUT_MS="60000"

# Ollama (local, free). Pull a model first: ollama pull llama3.2
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# Google Gemini (free API key from https://aistudio.google.com/apikey).
# Uses Google's OpenAI-compatible endpoint, so no extra SDK is required.
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Any OpenAI-compatible hosted endpoint (OpenAI, Groq, Together, OpenRouter...)
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional embeddings. EMBEDDING_PROVIDER: none | ollama | openai
EMBEDDING_PROVIDER="none"
EMBEDDING_MODEL="nomic-embed-text"

# Optional speech-to-text (OpenAI-compatible /audio/transcriptions)
STT_PROVIDER="none"
STT_BASE_URL="https://api.openai.com/v1"
STT_API_KEY=""
STT_MODEL="whisper-1"

# ---------------------------------------------------------------------------
# Storage. STORAGE_DRIVER: local | s3
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
MAX_UPLOAD_MB="25"

# S3-compatible object storage (optional, production)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Local embedded PostgreSQL control (scripts/db.mjs)
# ---------------------------------------------------------------------------
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="postgres"
PG_DATABASE="nexa"
PG_TEST_DATABASE="nexa_test"
PG_DATA_DIR=".pgdata"
