{
  "name": "nexa",
  "version": "1.0.0",
  "private": true,
  "description": "NEXA — Every conversation, more intelligent.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:setup": "node scripts/db.mjs start && prisma migrate deploy && tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "e2e": "node scripts/e2e.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.901.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "date-fns": "4.1.0",
    "dotenv": "^16.6.1",
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
